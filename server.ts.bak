import express from "express";
import path from "path";
import fs from "fs";
import https from "https";
import { createServer as createViteServer } from "vite";
import { getDb } from "./src/db";
import { z } from "zod";
import crypto from "crypto";
import { initializeApp, getApps, App } from "firebase-admin/app";
import * as xlsx from "xlsx";
import { getAuth } from "firebase-admin/auth";

const app = express();
const PORT = 3000;

app.use(express.json());

// Firebase configuration for server-side token verification
let firebaseProjectId: string | null = null;
try {
  const configPath = path.join(process.cwd(), "firebase-applet-config.json");
  if (fs.existsSync(configPath)) {
    const parsed = JSON.parse(fs.readFileSync(configPath, "utf-8"));
    firebaseProjectId = parsed.projectId || "gen-lang-client-0045035019";
  }
} catch (err) {
  console.warn("Could not read firebase-applet-config.json:", err);
  firebaseProjectId = "gen-lang-client-0045035019"; // Fallback to known project ID
}

let firebaseAdminApp: App | undefined;
if (getApps().length === 0 && firebaseProjectId) {
  firebaseAdminApp = initializeApp({
    projectId: firebaseProjectId
  });
} else {
  firebaseAdminApp = getApps()[0];
}

export interface VerifiedFirebaseUser {
  uid: string;
  email: string;
  emailVerified: boolean;
}

export function extractAuthToken(req: express.Request): string | null {
  const authHeader = req.headers["authorization"];
  if (authHeader && typeof authHeader === "string" && authHeader.startsWith("Bearer ")) {
    return authHeader.substring(7).trim();
  }
  return null;
}

export async function verifyFirebaseIdToken(idToken: string): Promise<VerifiedFirebaseUser | null> {
  if (!idToken || typeof idToken !== "string") return null;

  try {
    const auth = getAuth(firebaseAdminApp);
    const decodedToken = await auth.verifyIdToken(idToken);
    
    const uid = decodedToken.uid;
    const email = (decodedToken.email || "").toLowerCase().trim();
    const emailVerified = Boolean(decodedToken.email_verified);
    
    return { uid, email, emailVerified };
  } catch (error) {
    // Cryptographic verification failed
    console.warn("Firebase ID token verification failed:", error);
    return null; // Fail securely, do not fallback to unverified claims
  }
}

// Robust Christ University Email Validator
// Accepted student email domain is christuniversity.in or *.christuniversity.in (e.g. r.hariharan@bcomafh.christuniversity.in)
export function isValidChristEmail(email: string): boolean {
  if (!email || typeof email !== "string") return false;
  const trimmed = email.trim().toLowerCase();
  const match = trimmed.match(/^[^\s@]+@([^\s@]+)$/);
  if (!match) return false;
  const domain = match[1];
  return domain === "christuniversity.in" || domain.endsWith(".christuniversity.in");
}

// In-memory sliding rate limiter for abuse protection
const authRateLimitMap = new Map<string, { count: number; resetAt: number }>();
function authRateLimiter(req: express.Request, res: express.Response, next: express.NextFunction) {
  const ip = req.ip || req.socket.remoteAddress || "client";
  const now = Date.now();
  const windowMs = 60 * 1000; // 1 minute window
  const maxRequests = 60; // 60 requests per minute

  const record = authRateLimitMap.get(ip);
  if (!record || now > record.resetAt) {
    authRateLimitMap.set(ip, { count: 1, resetAt: now + windowMs });
    return next();
  }

  if (record.count >= maxRequests) {
    return res.status(429).json({
      error: "TOO_MANY_REQUESTS",
      message: "Too many authentication requests. Please wait a moment before trying again."
    });
  }

  record.count += 1;
  next();
}

app.use("/api/auth", authRateLimiter);

const teamMemberSchema = z.object({
  name: z.string().min(1, "Name is required"),
  reg_number: z.string().min(1, "Registration number is required"),
});

const studentSignupSchema = z.object({
  fullName: z.string().min(2, "Full name must be at least 2 characters"),
  collegeEmail: z.string().email("Invalid email format"),
  rollNumber: z.string().min(2, "Roll number is required"),
  contactNumber: z.string().min(10, "Contact number must be at least 10 digits"),
  programme: z.string().optional(),
  department: z.string().optional(),
  password: z.string().min(6, "Password must be at least 6 characters").optional(),
}).refine(data => Boolean(data.programme?.trim() || data.department?.trim()), {
  message: "Programme is required",
  path: ["programme"],
});

const registrationSchema = z.object({
  full_name: z.string().optional(),
  fullName: z.string().optional(),
  email: z.string().email("Invalid email format"),
  phone: z.string().optional(),
  contactNumber: z.string().optional(),
  institute: z.string().optional(),
  organizationInstitute: z.string().optional(),
  roll_number: z.string().optional(),
  rollNumber: z.string().optional(),
  department: z.string().optional(),
  event_id: z.string().optional(),
  eventId: z.string().optional(),
  team_members: z.array(teamMemberSchema).nullable().optional(),
  teamMembers: z.array(teamMemberSchema).nullable().optional(),
  event_specific_responses: z.record(z.string(), z.any()).nullable().optional(),
  eventSpecificResponses: z.record(z.string(), z.any()).nullable().optional(),
}).refine(data => (data.full_name && data.full_name.trim().length >= 2) || (data.fullName && data.fullName.trim().length >= 2), {
  message: "Full name must be at least 2 characters",
  path: ["full_name"],
}).refine(data => {
  const phone = (data.phone || data.contactNumber || "").replace(/\D/g, "");
  return phone.length >= 10;
}, {
  message: "Phone number must be at least 10 digits",
  path: ["phone"],
});

async function handleRegistration(req: express.Request, res: express.Response, db: any) {
  try {
    const token = extractAuthToken(req);
    if (!token) {
      return res.status(401).json({
        error: "UNAUTHORIZED",
        message: "Authentication required for registration."
      });
    }

    const verifiedUser = await verifyFirebaseIdToken(token);
    if (!verifiedUser) {
      return res.status(401).json({
        error: "INVALID_TOKEN",
        message: "Invalid or expired authentication token."
      });
    }

    const rawBody = {
      ...req.body,
      event_id: req.body.event_id || req.body.eventId || req.params.id,
    };

    const parseResult = registrationSchema.safeParse(rawBody);
    if (!parseResult.success) {
      const fields: Record<string, string> = {};
      parseResult.error.issues.forEach(err => {
        const key = err.path[0]?.toString() || "general";
        fields[key] = err.message;
        if (key === "full_name") fields["fullName"] = err.message;
        if (key === "phone") fields["contactNumber"] = err.message;
        if (key === "institute") fields["organizationInstitute"] = err.message;
      });
      return res.status(400).json({
        error: "VALIDATION_ERROR",
        message: "One or more fields are invalid.",
        fields
      });
    }

    const data = parseResult.data;
    const normalizedEmail = data.email.toLowerCase().trim();

    // Enforce Christ University student domain validation on backend
    if (!isValidChristEmail(normalizedEmail)) {
      return res.status(400).json({
        error: "INVALID_EMAIL_DOMAIN",
        message: "Registration is restricted to official Christ University student email addresses (*.christuniversity.in).",
        fields: {
          email: "Must be a valid Christ University student email (e.g. *.christuniversity.in)"
        }
      });
    }

    const rawPhone = (data.phone || data.contactNumber || "").replace(/\D/g, "");
    const normalizedPhone = rawPhone;
    const normalizedFullName = (data.full_name || data.fullName || "").trim();
    const normalizedInstitute = (data.institute || data.organizationInstitute || "Christ University").trim();
    const normalizedRollNumber = (data.roll_number || data.rollNumber || "").trim() || null;
    const normalizedDepartment = (data.department || "").trim() || null;
    const targetEventId = rawBody.event_id;
    const teamMembersList = data.team_members || data.teamMembers || null;
    const eventSpecificData = data.event_specific_responses || data.eventSpecificResponses || null;

    if (!targetEventId) {
      return res.status(400).json({
        error: "VALIDATION_ERROR",
        message: "Event ID is required",
        fields: { event_id: "Event ID is required", eventId: "Event ID is required" }
      });
    }

    // Stage 3: Event existence
    const { rows: eventRows } = await db.execute({
      sql: "SELECT * FROM events WHERE id = ?",
      args: [targetEventId]
    });
    const event = eventRows[0];
    
    if (!event) {
      return res.status(404).json({ error: "EVENT_NOT_FOUND", message: "The selected event does not exist." });
    }

    // Stage 4: Group event validation
    if (event.type === "group") {
      if (!teamMembersList || !Array.isArray(teamMembersList)) {
        return res.status(400).json({
          error: "VALIDATION_ERROR",
          message: "Team members are required for group events.",
          fields: { team_members: "Team members are required for group events.", teamMembers: "Team members are required for group events." }
        });
      }
      const totalTeamSize = teamMembersList.length + 1; // including team lead
      const minSize = (event.min_team_size as number) || 1;
      const maxSize = (event.max_team_size as number) || 20;

      if (totalTeamSize < minSize || totalTeamSize > maxSize) {
        return res.status(400).json({
          error: "VALIDATION_ERROR",
          message: `Total team size (lead + members) must be between ${minSize} and ${maxSize}.`,
          fields: { 
            team_members: `Total team size must be between ${minSize} and ${maxSize}.`,
            teamMembers: `Total team size must be between ${minSize} and ${maxSize}.`
          }
        });
      }
    }

    // Start transaction
    const tx = await db.transaction('write');
    
    try {
      // Find user by firebase_uid (identity derived from token)
      const { rows: userRows } = await tx.execute({
        sql: "SELECT id, roll_number, department FROM users WHERE firebase_uid = ?",
        args: [verifiedUser.uid]
      });
      let userId = userRows[0]?.id as string | undefined;

      if (!userId) {
        await tx.rollback();
        return res.status(404).json({
          error: "ACCOUNT_PROFILE_NOT_FOUND",
          message: "Student account profile not found. Please complete the setup process."
        });
      } else {
        await tx.execute({
          sql: "UPDATE users SET full_name = ?, phone = ?, institute = ?, roll_number = COALESCE(?, roll_number), department = COALESCE(?, department) WHERE id = ?",
          args: [normalizedFullName, normalizedPhone, normalizedInstitute, normalizedRollNumber, normalizedDepartment, userId]
        });
      }

      // Check duplicate registration
      const { rows: existingRegRows } = await tx.execute({
        sql: "SELECT id FROM registrations WHERE user_id = ? AND event_id = ?",
        args: [userId, targetEventId]
      });

      if (existingRegRows.length > 0) {
        await tx.rollback();
        return res.status(409).json({
          error: "ALREADY_REGISTERED",
          message: "You are already registered for this event.",
          registration_id: existingRegRows[0].id
        });
      }

      // Create registration
      const registrationId = crypto.randomUUID();
      const teamMembersJson = teamMembersList ? JSON.stringify(teamMembersList) : null;
      const eventSpecificJson = eventSpecificData ? JSON.stringify(eventSpecificData) : null;
      
      await tx.execute({
        sql: "INSERT INTO registrations (id, user_id, event_id, team_members, event_specific_data) VALUES (?, ?, ?, ?, ?)",
        args: [registrationId, userId, targetEventId, teamMembersJson, eventSpecificJson]
      });
      
      await tx.commit();

      // Post-commit response
      return res.status(201).json({
        registration_id: registrationId,
        reg_id: registrationId,
        event_name: event.name,
        full_name: normalizedFullName,
        email: normalizedEmail,
        status: "registered",
        created_at: new Date().toISOString(),
        event: {
          id: event.id,
          name: event.name,
          category: event.category,
          type: event.type,
          time_start: event.time_start,
          venue_or_platform: event.venue_or_platform
        }
      });
    } catch (err) {
      await tx.rollback();
      throw err;
    }
  } catch (error) {
    console.error("Registration processing error:", error);
    return res.status(500).json({ error: "INTERNAL_ERROR", message: "Failed to complete event registration." });
  }
}

async function startServer() {
  const db = await getDb();

  // API Routes
  app.get("/api/events", async (req, res) => {
    try {
      const { rows } = await db.execute("SELECT * FROM events ORDER BY id ASC");
      const events = rows.map(r => ({
        ...r,
        rules: r.rules ? JSON.parse(r.rules as string) : [],
        specific_fields: r.specific_fields ? JSON.parse(r.specific_fields as string) : undefined
      }));
      res.status(200).json({ events });
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "SERVER_ERROR", message: "Unable to fetch events. Please try again." });
    }
  });

  app.get("/api/events/:id", async (req, res) => {
    try {
      const { rows } = await db.execute({
        sql: "SELECT * FROM events WHERE id = ?",
        args: [req.params.id]
      });
      const event = rows[0];
      if (!event) {
        return res.status(404).json({ error: "EVENT_NOT_FOUND", message: "The selected event does not exist." });
      }
      res.status(200).json({
        ...event,
        rules: event.rules ? JSON.parse(event.rules as string) : [],
        specific_fields: event.specific_fields ? JSON.parse(event.specific_fields as string) : undefined
      });
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "SERVER_ERROR", message: "Server error" });
    }
  });

  // ========================================================
  // AUTHENTICATION & STUDENT ACCOUNT CREATION ENDPOINTS
  // ========================================================

  // 1. Pre-validation of College Email & Domain Restriction
  app.post("/api/auth/validate-email", async (req, res) => {
    try {
      const email = (req.body.email || "").trim().toLowerCase();
      if (!email) {
        return res.status(400).json({ valid: false, message: "Email is required." });
      }

      if (!isValidChristEmail(email)) {
        return res.status(400).json({
          valid: false,
          error: "INVALID_COLLEGE_DOMAIN",
          message: "Account creation is restricted to official Christ University student email addresses (*.christuniversity.in)."
        });
      }

      const { rows } = await db.execute({
        sql: "SELECT id FROM users WHERE LOWER(email) = ?",
        args: [email]
      });

      if (rows.length > 0) {
        return res.status(409).json({
          valid: false,
          error: "DUPLICATE_ACCOUNT",
          message: "AN ACCOUNT ALREADY EXISTS FOR THIS EMAIL. Please log in instead."
        });
      }

      return res.status(200).json({ valid: true, message: "Email domain is valid." });
    } catch (error) {
      console.error("Email validation error:", error);
      return res.status(500).json({ valid: false, message: "Validation service error." });
    }
  });

  // 2. Student Account Creation / Registration Endpoint (Authenticated via Firebase ID Token)
  app.post("/api/auth/signup", async (req, res) => {
    try {
      const token = extractAuthToken(req);
      if (!token) {
        return res.status(401).json({
          error: "UNAUTHORIZED",
          message: "A valid Firebase authentication token is required to create a student profile."
        });
      }

      const verifiedUser = await verifyFirebaseIdToken(token);
      if (!verifiedUser) {
        return res.status(401).json({
          error: "INVALID_TOKEN",
          message: "Invalid or expired authentication token. Please sign in again."
        });
      }

      const parseResult = studentSignupSchema.safeParse(req.body);
      if (!parseResult.success) {
        const firstError = parseResult.error.issues[0]?.message || "Validation failed";
        return res.status(400).json({
          error: "VALIDATION_ERROR",
          message: firstError,
          fields: parseResult.error.issues.reduce((acc: any, i) => {
            acc[i.path[0]?.toString() || "general"] = i.message;
            return acc;
          }, {})
        });
      }

      const { fullName, collegeEmail, rollNumber, contactNumber, department, programme } = parseResult.data;
      const finalProgramme = (programme || department || "").trim();
      const normalizedEmail = collegeEmail.toLowerCase().trim();

      // Enforce that the signup payload email matches the authenticated Firebase identity
      if (normalizedEmail !== verifiedUser.email.toLowerCase().trim()) {
        return res.status(403).json({
          error: "IDENTITY_MISMATCH",
          message: "The student email does not match the authenticated account identity."
        });
      }

      // Enforce Christ University student domain validation
      if (!isValidChristEmail(normalizedEmail)) {
        return res.status(400).json({
          error: "INVALID_DOMAIN",
          message: "BLOSSOMS is exclusively for Christ University students. Registration is restricted to official student email addresses (*.christuniversity.in)."
        });
      }

      const rawPhone = contactNumber.replace(/\D/g, "");
      const isVerified = verifiedUser.emailVerified ? 1 : 0;

      // CASE 4 & CASE 6: Check if firebase_uid is already linked to another profile
      const { rows: existingByUid } = await db.execute({
        sql: "SELECT id, email, full_name, roll_number, department, phone, email_verified FROM users WHERE firebase_uid = ?",
        args: [verifiedUser.uid]
      });

      if (existingByUid.length > 0) {
        const user = existingByUid[0];
        await db.execute({
          sql: `
            UPDATE users 
            SET 
              full_name = ?,
              phone = ?,
              roll_number = ?,
              department = ?,
              email_verified = ?,
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `,
          args: [fullName.trim(), rawPhone, rollNumber.trim(), finalProgramme, isVerified, user.id]
        });

        return res.status(200).json({
          success: true,
          message: "Student account profile saved successfully.",
          user: {
            id: user.id,
            firebaseUid: verifiedUser.uid,
            fullName: fullName.trim(),
            email: user.email,
            rollNumber: rollNumber.trim(),
            department: finalProgramme,
            programme: finalProgramme,
            phone: rawPhone,
            institute: "Christ University",
            emailVerified: Boolean(isVerified || user.email_verified)
          }
        });
      }

      // Check if user already exists by email
      const { rows: existingByEmail } = await db.execute({
        sql: "SELECT id, firebase_uid, full_name, roll_number, department, phone, email_verified FROM users WHERE LOWER(email) = ?",
        args: [normalizedEmail]
      });

      let userId: string;

      if (existingByEmail.length > 0) {
        const existing = existingByEmail[0];
        // CASE 6: Email already belongs to a different Firebase UID
        if (existing.firebase_uid && existing.firebase_uid !== verifiedUser.uid) {
          return res.status(409).json({
            error: "DUPLICATE_ACCOUNT",
            message: "This email is already associated with another account. Please log in."
          });
        }

        // CASE 5: Existing SQLite profile without Firebase UID -> Safely link it
        userId = existing.id as string;
        await db.execute({
          sql: `
            UPDATE users 
            SET 
              firebase_uid = ?,
              full_name = ?,
              phone = ?,
              roll_number = ?,
              department = ?,
              email_verified = ?,
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `,
          args: [verifiedUser.uid, fullName.trim(), rawPhone, rollNumber.trim(), finalProgramme, isVerified, userId]
        });
      } else {
        // CASE 1: Brand new user
        userId = crypto.randomUUID();
        await db.execute({
          sql: `
            INSERT INTO users (id, firebase_uid, full_name, email, phone, institute, roll_number, department, email_verified)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
          `,
          args: [userId, verifiedUser.uid, fullName.trim(), normalizedEmail, rawPhone, "Christ University", rollNumber.trim(), finalProgramme, isVerified]
        });
      }

      return res.status(201).json({
        success: true,
        message: "Student account created successfully. Please verify your college email.",
        user: {
          id: userId,
          firebaseUid: verifiedUser.uid,
          fullName: fullName.trim(),
          email: normalizedEmail,
          rollNumber: rollNumber.trim(),
          department: finalProgramme,
          programme: finalProgramme,
          phone: rawPhone,
          institute: "Christ University",
          emailVerified: Boolean(isVerified)
        }
      });
    } catch (error) {
      console.error("Signup error:", error);
      return res.status(500).json({ error: "SERVER_ERROR", message: "Failed to create student account." });
    }
  });

  // 3. Sync User Profile State (Invoked on Login & Email Verification Handshake)
  app.post("/api/account/sync", async (req, res) => {
    try {
      const token = extractAuthToken(req);
      if (!token) {
        return res.status(401).json({
          error: "UNAUTHORIZED",
          message: "Authentication required for account sync."
        });
      }

      const verifiedUser = await verifyFirebaseIdToken(token);
      if (!verifiedUser) {
        return res.status(401).json({
          error: "INVALID_TOKEN",
          message: "Invalid or expired authentication token."
        });
      }

      const email = verifiedUser.email.toLowerCase().trim();
      
      if (!isValidChristEmail(email)) {
        return res.status(400).json({
          error: "INVALID_DOMAIN",
          message: "Account must belong to the permitted Christ University domain structure."
        });
      }

      const { fullName, name, rollNumber, roll_number, department, phone, contactNumber } = req.body;
      const finalName = (fullName || name || "").trim();
      const finalRoll = (rollNumber || roll_number || "").trim();
      const finalDept = (department || "").trim();
      const finalPhone = (phone || contactNumber || "").replace(/\D/g, "");
      const isVerified = verifiedUser.emailVerified ? 1 : 0;
      const targetFirebaseUid = verifiedUser.uid;

      // Find existing user by firebase_uid
      const { rows: existingUser } = await db.execute({
        sql: "SELECT id, firebase_uid, full_name, roll_number, department, phone, email_verified FROM users WHERE firebase_uid = ?",
        args: [targetFirebaseUid]
      });

      let userId = existingUser[0]?.id as string | undefined;

      if (!userId) {
        // Find existing user by email as fallback for migration
        const { rows: existingByEmail } = await db.execute({
          sql: "SELECT id, firebase_uid FROM users WHERE LOWER(email) = ?",
          args: [email]
        });
        
        if (existingByEmail.length > 0) {
           const existing = existingByEmail[0];
           if (existing.firebase_uid && existing.firebase_uid !== targetFirebaseUid) {
             return res.status(409).json({ error: "DUPLICATE_ACCOUNT", message: "Email associated with another account." });
           }
           userId = existing.id as string;
        } else {
          // Sync endpoint should not arbitrarily create a user. The user should use signup.
          return res.status(404).json({ error: "ACCOUNT_PROFILE_NOT_FOUND", message: "Student account profile not found. Please complete signup." });
        }
      }

      if (userId) {
        await db.execute({
          sql: `
            UPDATE users 
            SET 
              firebase_uid = COALESCE(firebase_uid, ?),
              full_name = CASE WHEN ? != '' THEN ? ELSE full_name END,
              roll_number = CASE WHEN ? != '' THEN ? ELSE roll_number END,
              department = CASE WHEN ? != '' THEN ? ELSE department END,
              phone = CASE WHEN ? != '' THEN ? ELSE phone END,
              email_verified = CASE WHEN ? = 1 THEN 1 ELSE email_verified END,
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `,
          args: [targetFirebaseUid, finalName, finalName, finalRoll, finalRoll, finalDept, finalDept, finalPhone, finalPhone, isVerified, userId]
        });
      }

      const { rows: updatedRows } = await db.execute({
        sql: "SELECT id, firebase_uid, full_name, email, phone, institute, roll_number, department, email_verified FROM users WHERE id = ?",
        args: [userId]
      });
      const updatedUser: any = updatedRows[0];

      return res.status(200).json({
        success: true,
        user: {
          id: updatedUser.id,
          firebaseUid: updatedUser.firebase_uid,
          fullName: updatedUser.full_name || "",
          name: updatedUser.full_name || "",
          email: updatedUser.email,
          rollNumber: updatedUser.roll_number || "",
          roll_number: updatedUser.roll_number || "",
          department: updatedUser.department || "",
          phone: updatedUser.phone || "",
          contactNumber: updatedUser.phone || "",
          institute: updatedUser.institute || "Christ University",
          emailVerified: Boolean(updatedUser.email_verified)
        }
      });
    } catch (error) {
      console.error("Account sync error:", error);
      return res.status(500).json({ error: "SERVER_ERROR", message: "Failed to sync account profile." });
    }
  });

  app.post("/api/register", async (req, res) => {
    await handleRegistration(req, res, db);
  });

  app.post("/api/events/:id/register", async (req, res) => {
    await handleRegistration(req, res, db);
  });

  // Account information and registrations for the authenticated user
  app.get("/api/account", async (req, res) => {
    try {
      const token = extractAuthToken(req);
      if (!token) {
        return res.status(401).json({
          error: "UNAUTHORIZED",
          message: "Authentication required to access account."
        });
      }

      const verifiedUser = await verifyFirebaseIdToken(token);
      if (!verifiedUser) {
        return res.status(401).json({
          error: "INVALID_TOKEN",
          message: "Invalid or expired authentication token."
        });
      }

      // Query user in database by firebase_uid
      const { rows: userRows } = await db.execute({
        sql: "SELECT id, firebase_uid, full_name, email, phone, institute, roll_number, department, email_verified, created_at FROM users WHERE firebase_uid = ?",
        args: [verifiedUser.uid]
      });

      let user: any = userRows[0];
      
      // Fallback to finding by email if no firebase_uid match (migration)
      if (!user) {
         const { rows: emailUserRows } = await db.execute({
           sql: "SELECT id, firebase_uid, full_name, email, phone, institute, roll_number, department, email_verified, created_at FROM users WHERE LOWER(email) = ?",
           args: [verifiedUser.email.toLowerCase()]
         });
         const fallbackUser = emailUserRows[0];
         if (fallbackUser && (!fallbackUser.firebase_uid || fallbackUser.firebase_uid === verifiedUser.uid)) {
           user = fallbackUser;
         }
      }

      let registrations: any[] = [];

      if (user) {
        // Auto-link firebase_uid and sync email_verified if verified via token
        if (verifiedUser) {
          const needsUidLink = !user.firebase_uid && verifiedUser.uid;
          const needsVerificationUpdate = verifiedUser.emailVerified && !user.email_verified;

          if (needsUidLink || needsVerificationUpdate) {
            await db.execute({
              sql: "UPDATE users SET firebase_uid = COALESCE(firebase_uid, ?), email_verified = CASE WHEN ? = 1 THEN 1 ELSE email_verified END, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
              args: [verifiedUser.uid, verifiedUser.emailVerified ? 1 : 0, user.id]
            });
            user.firebase_uid = user.firebase_uid || verifiedUser.uid;
            if (verifiedUser.emailVerified) user.email_verified = 1;
          }
        }

        // Query registrations belonging to the user
        const { rows: regRows } = await db.execute({
          sql: `
            SELECT 
              r.id as registration_id,
              r.user_id,
              r.event_id,
              r.team_members,
              r.event_specific_data,
              r.status,
              r.created_at,
              e.name as event_name,
              e.category as event_category,
              e.type as event_type,
              e.min_team_size,
              e.max_team_size,
              e.date as event_date,
              e.time_start as event_time_start,
              e.time_end as event_time_end,
              e.submission_type,
              e.description as event_description
            FROM registrations r
            JOIN events e ON r.event_id = e.id
            WHERE r.user_id = ?
            ORDER BY r.created_at DESC
          `,
          args: [user.id]
        });

        registrations = regRows.map(r => {
          let parsedTeamMembers = null;
          let parsedEventSpecific = null;
          try {
            if (r.team_members) parsedTeamMembers = JSON.parse(r.team_members as string);
          } catch (_e) {}
          try {
            if (r.event_specific_data) parsedEventSpecific = JSON.parse(r.event_specific_data as string);
          } catch (_e) {}

          return {
            id: r.registration_id,
            eventId: r.event_id,
            status: (r.status as string || "REGISTERED").toUpperCase(),
            createdAt: r.created_at,
            event: {
              id: r.event_id,
              name: r.event_name,
              category: r.event_category,
              type: r.event_type,
              min_team_size: r.min_team_size,
              max_team_size: r.max_team_size,
              date: r.event_date,
              time_start: r.event_time_start,
              time_end: r.event_time_end,
              submission_type: r.submission_type,
              description: r.event_description
            },
            teamMembers: parsedTeamMembers || [],
            eventSpecificResponses: parsedEventSpecific || {}
          };
        });
      }
      
      if (!user) {
        return res.status(404).json({
          error: "ACCOUNT_PROFILE_NOT_FOUND",
          message: "Student account record not found."
        });
      }

      return res.status(200).json({
        user: {
          id: user.id,
          firebaseUid: user.firebase_uid,
          name: user.full_name || "",
          fullName: user.full_name || "",
          email: user.email,
          phone: user.phone || "",
          contactNumber: user.phone || "",
          institute: user.institute || "Christ University",
          rollNumber: user.roll_number || "",
          roll_number: user.roll_number || "",
          department: user.department || "",
          emailVerified: Boolean(user.email_verified)
        },
        registrations
      });
    } catch (error) {
      console.error("Account API error:", error);
      return res.status(500).json({ error: "SERVER_ERROR", message: "Failed to retrieve account records." });
    }
  });

  // Profile update endpoint
  app.post("/api/account/profile", async (req, res) => {
    try {
      const token = extractAuthToken(req);
      if (!token) {
        return res.status(401).json({ error: "UNAUTHORIZED", message: "Authentication required to update profile." });
      }

      const verifiedUser = await verifyFirebaseIdToken(token);
      if (!verifiedUser) {
        return res.status(401).json({ error: "INVALID_TOKEN", message: "Invalid or expired authentication token." });
      }

      const { fullName, name, rollNumber, roll_number, department, institute, phone, contactNumber } = req.body;
      const finalName = (fullName || name || "").trim();
      const finalRoll = (rollNumber || roll_number || "").trim();
      const finalDept = (department || "").trim();
      const finalInstitute = (institute || "Christ University").trim();
      const finalPhone = (phone || contactNumber || "").replace(/\D/g, "");

      const { rows: existingUser } = await db.execute({
        sql: "SELECT id FROM users WHERE firebase_uid = ?",
        args: [verifiedUser.uid]
      });

      let userId = existingUser[0]?.id;
      
      if (!userId) {
        // Migration fallback
        const { rows: existingByEmail } = await db.execute({
           sql: "SELECT id, firebase_uid FROM users WHERE LOWER(email) = ?",
           args: [verifiedUser.email.toLowerCase()]
        });
        const fallbackUser = existingByEmail[0];
        
        if (fallbackUser && (!fallbackUser.firebase_uid || fallbackUser.firebase_uid === verifiedUser.uid)) {
           userId = fallbackUser.id;
        } else if (fallbackUser && fallbackUser.firebase_uid !== verifiedUser.uid) {
           return res.status(409).json({ error: "DUPLICATE_ACCOUNT", message: "Email associated with another account." });
        }
        
        if (!userId) {
           return res.status(404).json({ error: "ACCOUNT_PROFILE_NOT_FOUND", message: "Student account profile not found. Please complete signup." });
        }
      }

      await db.execute({
        sql: `
          UPDATE users 
          SET 
            full_name = CASE WHEN ? != '' THEN ? ELSE full_name END,
            roll_number = CASE WHEN ? != '' THEN ? ELSE roll_number END,
            department = CASE WHEN ? != '' THEN ? ELSE department END,
            institute = CASE WHEN ? != '' THEN ? ELSE institute END,
            phone = CASE WHEN ? != '' THEN ? ELSE phone END,
            updated_at = CURRENT_TIMESTAMP
          WHERE id = ?
        `,
        args: [finalName, finalName, finalRoll, finalRoll, finalDept, finalDept, finalInstitute, finalInstitute, finalPhone, finalPhone, userId]
      });

      return res.status(200).json({
        success: true,
        user: {
          id: userId,
          fullName: finalName,
          email: verifiedUser.email.toLowerCase(),
          rollNumber: finalRoll,
          department: finalDept,
          institute: finalInstitute,
          phone: finalPhone
        }
      });
    } catch (error) {
      console.error("Profile update error:", error);
      return res.status(500).json({ error: "SERVER_ERROR", message: "Unable to update profile." });
    }
  });

  app.get("/api/registrations/:email", async (req, res) => {
    try {
      const email = req.params.email.toLowerCase().trim();
      const { rows: registrations } = await db.execute({
        sql: `
          SELECT r.id as registration_id, e.name as event_name, r.status
          FROM registrations r
          JOIN events e ON r.event_id = e.id
          JOIN users u ON r.user_id = u.id
          WHERE u.email = ?
        `,
        args: [email]
      });
      
      res.status(200).json({ email, registrations });
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "server_error", message: "Server error" });
    }
  });

  // ==========================================
  // DEVELOPER INTERFACE API
  // ==========================================
  
  const DEVELOPER_EMAILS = [
    "rhariharan1616@gmail.com"
  ]; // Can be moved to env vars later

  const checkDeveloperAuth = async (req: express.Request, res: express.Response, next: express.NextFunction) => {
    try {
      const idToken = extractAuthToken(req);
      if (!idToken) return res.status(401).json({ error: "UNAUTHORIZED", message: "Missing token" });

      const verifiedUser = await verifyFirebaseIdToken(idToken);
      if (!verifiedUser) return res.status(401).json({ error: "UNAUTHORIZED", message: "Invalid token" });

      if (!DEVELOPER_EMAILS.includes(verifiedUser.email.toLowerCase())) {
        return res.status(403).json({ error: "FORBIDDEN", message: "Not authorized as developer" });
      }

      (req as any).developerUser = verifiedUser;
      next();
    } catch (e) {
      console.error("Developer auth error:", e);
      return res.status(500).json({ error: "SERVER_ERROR", message: "Auth error" });
    }
  };

  app.get("/api/developer/events", checkDeveloperAuth, async (req, res) => {
    try {
      const { rows: events } = await db.execute("SELECT id, name, category, type FROM events ORDER BY category, name");
      const { rows: stats } = await db.execute("SELECT event_id, COUNT(*) as count FROM registrations GROUP BY event_id");
      
      const countsMap = new Map();
      for (const stat of stats) {
        countsMap.set(stat.event_id, stat.count);
      }

      const eventsWithStats = events.map((e: any) => ({
        ...e,
        registration_count: countsMap.get(e.id) || 0
      }));

      res.status(200).json({ events: eventsWithStats });
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "server_error", message: "Server error" });
    }
  });

  app.get("/api/developer/events/:eventId/registrations", checkDeveloperAuth, async (req, res) => {
    try {
      const { eventId } = req.params;
      const { rows: registrations } = await db.execute({
        sql: `SELECT r.id, r.status, r.team_members, r.created_at, 
                     u.full_name, u.email, u.roll_number, u.phone, u.department as programme, u.institute
              FROM registrations r
              JOIN users u ON r.user_id = u.id
              WHERE r.event_id = ?
              ORDER BY r.created_at DESC`,
        args: [eventId]
      });
      
      // Parse team members if stringified
      const formattedRegistrations = registrations.map((r: any) => ({
        ...r,
        team_members: typeof r.team_members === 'string' ? JSON.parse(r.team_members) : r.team_members
      }));

      res.status(200).json({ registrations: formattedRegistrations });
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "server_error", message: "Server error" });
    }
  });

  app.get("/api/developer/export/event/:eventId", checkDeveloperAuth, async (req, res) => {
    try {
      const { eventId } = req.params;
      
      const { rows: events } = await db.execute({
        sql: `SELECT name FROM events WHERE id = ?`,
        args: [eventId]
      });
      
      if (events.length === 0) return res.status(404).json({ error: "NOT_FOUND" });
      const eventName = (events[0] as any).name;

      const { rows: registrations } = await db.execute({
        sql: `SELECT u.full_name as Name, u.email as Email, u.roll_number as "Roll Number", 
                     u.phone as "Contact Number", u.department as Programme, r.status as Status, 
                     r.team_members as "Team Members", r.created_at as "Registered On"
              FROM registrations r
              JOIN users u ON r.user_id = u.id
              WHERE r.event_id = ?
              ORDER BY r.created_at DESC`,
        args: [eventId]
      });

      const formattedData = registrations.map((r: any) => {
        let teamMembersStr = "";
        try {
          if (r["Team Members"]) {
            const team = JSON.parse(r["Team Members"]);
            if (Array.isArray(team)) {
              teamMembersStr = team.map((m: any) => `${m.name} (${m.reg_number})`).join(", ");
            }
          }
        } catch(e) {}
        
        return {
          ...r,
          "Team Members": teamMembersStr,
          "Registered On": new Date(r["Registered On"]).toLocaleString()
        };
      });

      const worksheet = xlsx.utils.json_to_sheet(formattedData);
      const workbook = xlsx.utils.book_new();
      xlsx.utils.book_append_sheet(workbook, worksheet, "Registrations");
      
      const buffer = xlsx.write(workbook, { type: "buffer", bookType: "xlsx" });
      
      res.setHeader('Content-Disposition', `attachment; filename="Blossoms_${eventName.replace(/\\s+/g, '_')}_Registrations.xlsx"`);
      res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      return res.send(buffer);
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "server_error" });
    }
  });

  app.get("/api/developer/export/all", checkDeveloperAuth, async (req, res) => {
    try {
      const { rows: events } = await db.execute("SELECT id, name FROM events");
      
      const workbook = xlsx.utils.book_new();
      
      for (const event of events) {
        const { rows: registrations } = await db.execute({
          sql: `SELECT u.full_name as Name, u.email as Email, u.roll_number as "Roll Number", 
                       u.phone as "Contact Number", u.department as Programme, r.status as Status, 
                       r.team_members as "Team Members", r.created_at as "Registered On"
                FROM registrations r
                JOIN users u ON r.user_id = u.id
                WHERE r.event_id = ?
                ORDER BY r.created_at DESC`,
          args: [(event as any).id]
        });

        const formattedData = registrations.map((r: any) => {
          let teamMembersStr = "";
          try {
            if (r["Team Members"]) {
              const team = JSON.parse(r["Team Members"]);
              if (Array.isArray(team)) {
                teamMembersStr = team.map((m: any) => `${m.name} (${m.reg_number})`).join(", ");
              }
            }
          } catch(e) {}
          
          return {
            ...r,
            "Team Members": teamMembersStr,
            "Registered On": new Date(r["Registered On"]).toLocaleString()
          };
        });
        
        // Add a placeholder row if no registrations
        const sheetData = formattedData.length > 0 ? formattedData : [{ Name: "No registrations yet" }];

        const worksheet = xlsx.utils.json_to_sheet(sheetData);
        // Truncate event name for sheet name (max 31 chars)
        let sheetName = (event as any).name.substring(0, 31).replace(/[:\\\\/?*\\[\\]]/g, "");
        if (!sheetName) sheetName = "Event";
        
        // Ensure sheet names are unique
        let finalSheetName = sheetName;
        let counter = 1;
        while (workbook.SheetNames.includes(finalSheetName)) {
           finalSheetName = `${sheetName.substring(0, 27)}_${counter}`;
           counter++;
        }

        xlsx.utils.book_append_sheet(workbook, worksheet, finalSheetName);
      }
      
      const buffer = xlsx.write(workbook, { type: "buffer", bookType: "xlsx" });
      
      res.setHeader('Content-Disposition', 'attachment; filename="Blossoms_All_Registrations.xlsx"');
      res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      return res.send(buffer);
    } catch (error) {
      console.error(error);
      res.status(500).json({ error: "server_error" });
    }
  });

  // Explicit static serving for media files and public directory
  const publicPath = path.join(process.cwd(), "public");
  app.use(express.static(publicPath));
  app.use("/assets", express.static(path.join(publicPath, "assets")));
  app.get("/blossoms-bloom.mp4", (req, res) => {
    res.sendFile(path.join(publicPath, "blossoms-bloom.mp4"));
  });
  app.get("/assets/blossoms-bloom.mp4", (req, res) => {
    res.sendFile(path.join(publicPath, "assets", "blossoms-bloom.mp4"));
  });

  // Vite middleware for development
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(process.cwd(), "dist");
    app.use(express.static(distPath));
    app.get("*", (req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`Server running on http://localhost:${PORT}`);
  });
}

startServer();
